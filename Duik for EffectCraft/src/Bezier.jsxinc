// Serialized into EffectCraft expressions; no scripting-host dependencies.
function bezierSegment(p, from, to) {
    function at(t) {
        var s = 1-t, a = s*s*s, b = 3*s*s*t, c = 3*s*t*t, d = t*t*t;
        return [a*p[0][0]+b*p[1][0]+c*p[2][0]+d*p[3][0], a*p[0][1]+b*p[1][1]+c*p[2][1]+d*p[3][1]];
    }
    var count = 64, cumulative = [0], last = p[0];
    for (var i = 1; i <= count; i++) {
        var point = at(i/count), x = point[0]-last[0], y = point[1]-last[1];
        cumulative.push(cumulative[i-1]+Math.sqrt(x*x+y*y));
        last = point;
    }
    function locate(fraction) {
        if (fraction <= 0) return p[0];
        if (fraction >= 1) return p[3];
        var distance = fraction*cumulative[count];
        for (var j = 1; j <= count; j++) {
            var step = cumulative[j]-cumulative[j-1];
            if (distance <= cumulative[j] && step > 0) return at((j-1+(distance-cumulative[j-1])/step)/count);
        }
        return p[3];
    }
    return [locate(from),locate(to)];
}

// Apply local handle edits before rotating and translating the whole chain.
function bezierForwardPoints(points, pivot, restPivot, rootAngle, tipAngle) {
    function rotate(x, y, degrees) {
        var radians = degrees*Math.PI/180, c = Math.cos(radians), s = Math.sin(radians);
        return [x*c-y*s,x*s+y*c];
    }
    var tip = points[3], end = points[2];
    var handle = rotate(end[0]-tip[0],end[1]-tip[1],tipAngle);
    points[2] = [tip[0]+handle[0],tip[1]+handle[1]];
    return points.map(function (p) {
        var moved = rotate(p[0]-restPivot[0],p[1]-restPivot[1],rootAngle);
        return [pivot[0]+moved[0],pivot[1]+moved[1]];
    });
}
